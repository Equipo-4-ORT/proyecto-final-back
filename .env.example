# App
PORT=3000

# Postgres (usadas por docker-compose y por la conexión desde la app)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL completa de Postgres usada por Prisma. Formato: postgresql://USER:PASS@HOST:PORT/DB
DATABASE_URL=

# Google OAuth — Client ID web obtenido desde Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=

# Clave AES-256-GCM para encriptar refresh tokens en la BD.
# Generar con: openssl rand -hex 32
# Debe ser exactamente 64 caracteres hexadecimales (32 bytes).
ENCRYPTION_KEY=

# —— Integración Jira (OAuth 2.0 3LO de Atlassian) ——
# Cada empresa que despliega la plataforma registra SU PROPIA app OAuth en
# https://developer.atlassian.com/console/myapps/ y configura estos valores.
# El JIRA_REDIRECT_URI debe coincidir EXACTAMENTE con el registrado en la app.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:3000/api/jira/auth/callback

# Base del frontend, usada para construir el redirect post-callback de Jira.
# También es el origin permitido por CORS (con credentials) para las cookies.
FRONTEND_BASE_URL=http://localhost:5173

# ======================
# Auth — JWT (access token) y cookies HttpOnly
# ======================
# Secret del access token. Generar con: openssl rand -hex 64
# Durante la migración el código acepta JWT_SECRET como alias si este falta.
JWT_ACCESS_SECRET=
# Reservado para futuro (hoy el refresh es opaco, no JWT). openssl rand -hex 64
JWT_REFRESH_SECRET=
# Vida del access token. Default: 15m
JWT_ACCESS_TTL=15m

# Cookies de sesión
COOKIE_DOMAIN=        # vacío en localhost
COOKIE_SECURE=false   # true en prod (HTTPS)
# 'lax' si front y back son same-site (mismo dominio registrable, ej: localhost↔localhost).
# Si están en dominios distintos (ej: front en Vercel, back en Render/Railway), poner 'none'
# + COOKIE_SECURE=true, si no el browser NO manda la cookie cross-site y la auth da 401 en silencio.
COOKIE_SAMESITE=lax

# ======================
# Módulo IA
# ======================
# Provider de IA a usar para generar el informe diario.
# Soportados actualmente: openai, gemini
# Cada empresa elige su provider; solo necesita setear la API key del
# provider que va a usar (las demás pueden quedar vacías).
AI_PROVIDER=openai

# AI PROVIDER KEY
OPENAI_API_KEY=
GEMINI_API_KEY=

# ======================
# Batch diario (scheduler) — ver docs/specs/SPEC-batch-diario-sincronizacion.md
# ======================
# Timezone IANA con la que el batch interpreta la hora de fin de jornada (workEndTime)
# de cada empleado y arma las ventanas de sincronización. REQUERIDA para que el batch
# arranque: si es inválida o ausente, el batch no corre pero la API sigue funcionando.
SCHEDULER_TIMEZONE=America/Argentina/Buenos_Aires
# Máximo de usuarios sincronizados en paralelo en el pico. Default: 5
SCHEDULER_CONCURRENCY=5
# Poner 'false' para desactivar el batch (útil en dev/test). Default: true
SCHEDULER_ENABLED=true

# ======================
# Email (SMTP) — aviso diario al empleado de que su actividad está lista
# ======================
# Servidor de correo saliente. Cada empresa self-hosted configura el suyo.
# Si no se configura (host o from vacíos), el batch sincroniza igual y solo omite el email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false        # true para SMTPS (puerto 465)
SMTP_USER=
SMTP_PASS=
# Dirección remitente que verá el empleado (ej: "TimeTracker <no-reply@empresa.com>")
SMTP_FROM=
