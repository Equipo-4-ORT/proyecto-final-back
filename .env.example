# App
PORT=3000

# Postgres (usadas por docker-compose y por la conexión desde la app)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL completa de Postgres usada por Prisma. Formato: postgresql://USER:PASS@HOST:PORT/DB
DATABASE_URL=

# Google OAuth — Client ID web obtenido desde Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=

# Clave AES-256-GCM para encriptar refresh tokens en la BD.
# Generar con: openssl rand -hex 32
# Debe ser exactamente 64 caracteres hexadecimales (32 bytes).
ENCRYPTION_KEY=

# —— Integración Jira (OAuth 2.0 3LO de Atlassian) ——
# Cada empresa que despliega la plataforma registra SU PROPIA app OAuth en
# https://developer.atlassian.com/console/myapps/ y configura estos valores.
# El JIRA_REDIRECT_URI debe coincidir EXACTAMENTE con el registrado en la app.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:3000/api/jira/auth/callback

# Base del frontend, usada para construir el redirect post-callback de Jira
FRONTEND_BASE_URL=http://localhost:5173
